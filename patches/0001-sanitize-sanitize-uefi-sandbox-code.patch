+  LIST_ENTRY VMRegions;
+  /* List of Interfaces installed by this sandbox */
+  LIST_ENTRY InstalledInterfaces;
+  /* List of used interfaces */
+  LIST_ENTRY LocatedInterfaces;
+  /* List of trampoline contexts*/
