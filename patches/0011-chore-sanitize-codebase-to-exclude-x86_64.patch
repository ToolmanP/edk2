- */
-.text
-.align  8
-BEGIN_FUNC(CallCoreFunc)
-  push %rbp
-  movq %rsp, %rbp
-
-  # Protocol functions are ms_abi
-  movq (%rdi), %rcx
-  movq 0x8(%rdi), %rdx
-  movq 0x10(%rdi), %r8
-  movq 0x18(%rdi), %r9
-
-  push 0x28(%rdi)
-  push 0x20(%rdi)
-
-  # shadow space
-  sub $0x20, %rsp
-
-  movq %rsi, %rax
-  call *%rax
-
-  leave
