+SandboxExecuteCallback(IN REFLECT_FUNC_TYPE *Func, IN UINTN CalleeID,
+                       IN UINTN FuncAddress, UINTN *CallSiteParams) {
+  UEFI_SANDBOX *CallerSandbox, *CalleeSandbox;
+  POINTER_LIST PointerList;
